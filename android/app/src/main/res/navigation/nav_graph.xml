<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="vn.edu.usth.online_music_player.ui.home.HomeFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_search"
        android:name="vn.edu.usth.online_music_player.ui.search.SearchFragment"
        android:label="@string/menu_search"
        tools:layout="@layout/fragment_search" />

    <fragment
        android:id="@+id/navigation_library"
        android:name="vn.edu.usth.online_music_player.ui.library.LibraryFragment"
        android:label="@string/menu_library"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="vn.edu.usth.online_music_player.ui.profile.ProfileFragment"
        android:label="@string/menu_profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/playlist_detail_fragment"
        android:name="vn.edu.usth.online_music_player.ui.playlist.PlaylistDetailFragment"
        android:label="@string/playlist_detail_title"
        tools:layout="@layout/fragment_playlist_detail">
        <argument
            android:name="playlistId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/playlist_track_picker_fragment"
        android:name="vn.edu.usth.online_music_player.ui.playlist.PlaylistTrackPickerFragment"
        android:label="@string/playlist_picker_title"
        tools:layout="@layout/fragment_playlist_track_picker">
        <argument
            android:name="playlistId"
            app:argType="string" />
    </fragment>
</navigation>
