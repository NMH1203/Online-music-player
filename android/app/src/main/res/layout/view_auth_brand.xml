<?xml version="1.0" encoding="utf-8"?>
<!-- Figma auth header: app mark + "Online Music / Player". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_mini_player"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_audio_lines"
        app:tint="@color/text_primary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_brand_name"
            android:textAppearance="@style/TextAppearance.App.SectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auth_brand_suffix"
            android:textAppearance="@style/TextAppearance.App.Caption" />
    </LinearLayout>
</LinearLayout>
