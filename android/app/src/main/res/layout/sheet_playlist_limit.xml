<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Playlist limit – Free" (32:1088). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/limit_title"
            android:textAppearance="@style/TextAppearance.App.SectionTitle"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/limit_close"
            style="@style/Widget.App.IconButton"
            android:layout_marginEnd="-12dp"
            android:contentDescription="@string/add_to_playlist_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/limit_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.App.Caption" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_mini_player"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_queue"
            app:tint="@color/icon_secondary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/free_plan"
                android:textAppearance="@style/TextAppearance.App.CardTitle"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/limit_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Caption" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/limit_premium"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/view_premium" />

    <Button
        android:id="@+id/limit_not_now"
        style="@style/Widget.App.Button.Outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/not_now" />
</LinearLayout>
