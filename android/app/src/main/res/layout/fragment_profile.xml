<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Profile – Free / Premium" (32:1482, 2028:3). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/profile_title"
                android:textAppearance="@style/TextAppearance.App.ScreenTitle" />

            <ProgressBar
                android:id="@+id/profile_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/accent_primary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/account_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_avatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.App.Headline"
                    android:textSize="22sp"
                    tools:text="AL" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Headline"
                        android:textStyle="normal"
                        tools:text="Alex Lane" />

                    <TextView
                        android:id="@+id/profile_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.App.Caption"
                        tools:text="alex.lane@example.com" />

                    <TextView
                        android:id="@+id/profile_plan_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.App.Small"
                        tools:text="Free plan" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/profile_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:visibility="gone"
                tools:text="42 plays · 135 min listened" />

            <!-- Plan card: Free promo or Premium status. -->
            <LinearLayout
                android:id="@+id/plan_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_crown" />

                    <TextView
                        android:id="@+id/plan_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.App.SectionTitle"
                        android:textSize="18sp"
                        tools:text="Make more room for music" />

                    <TextView
                        android:id="@+id/plan_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_now_playing_row"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="@string/profile_premium_active"
                        android:textAppearance="@style/TextAppearance.App.Small"
                        android:textColor="@color/accent_primary"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/plan_benefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.App.Body"
                    android:textColor="@color/text_secondary"
                    tools:text="Unlimited playlists. Ad-free listening. Make every session yours." />

                <LinearLayout
                    android:id="@+id/plan_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_start_date"
                            android:textAppearance="@style/TextAppearance.App.Small" />

                        <TextView
                            android:id="@+id/plan_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/text_primary"
                            tools:text="Oct 1, 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_renewal_date"
                            android:textAppearance="@style/TextAppearance.App.Small" />

                        <TextView
                            android:id="@+id/plan_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.App.Caption"
                            android:textColor="@color/text_primary"
                            tools:text="Nov 1, 2026" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/upgrade_button"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/view_premium" />

                <Button
                    android:id="@+id/manage_plan_button"
                    style="@style/Widget.App.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/profile_manage_plan"
                    android:visibility="gone" />
            </LinearLayout>

            <include
                android:id="@+id/row_account"
                layout="@layout/item_profile_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp" />

            <include
                android:id="@+id/row_notifications"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/row_history"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/row_help"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/row_privacy"
                layout="@layout/item_profile_row" />

            <include
                android:id="@+id/row_sign_out"
                layout="@layout/item_profile_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profile_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.Small"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <include
            android:id="@+id/profile_state"
            layout="@layout/view_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
