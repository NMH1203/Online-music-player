<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Mini player": card above the bottom navigation; tap opens Now Playing. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@color/background_primary"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:id="@+id/playback_card"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/bg_mini_player"
        android:contentDescription="@string/mini_player_open"
        android:foreground="?attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/playback_artwork"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@color/background_primary"
                android:importantForAccessibility="no"
                android:padding="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Artwork"
                app:tint="@color/icon_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/playback_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.CardTitle"
                    android:textSize="13sp"
                    tools:text="Night Drive" />

                <TextView
                    android:id="@+id/playback_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Small"
                    tools:text="Nova Lane" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/playback_toggle"
                style="@style/Widget.App.IconButton"
                android:contentDescription="@string/action_pause"
                android:src="@drawable/ic_pause"
                app:tint="@color/accent_primary" />

            <ImageView
                android:id="@+id/playback_open"
                android:layout_width="32dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:paddingHorizontal="7dp"
                android:src="@drawable/ic_chevron_up"
                app:tint="@color/icon_secondary" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/playback_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:max="1000"
            app:indicatorColor="@color/accent_primary"
            app:trackColor="@android:color/transparent"
            app:trackCornerRadius="0dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="2dp" />
    </FrameLayout>
</FrameLayout>
