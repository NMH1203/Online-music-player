<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Section heading": title on the left, optional meta + "See all" on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.App.SectionTitle"
        tools:text="Recently played" />

    <TextView
        android:id="@+id/section_see_all"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:text="@string/action_see_all"
        android:textAppearance="@style/TextAppearance.App.Caption" />
</LinearLayout>
