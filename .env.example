# Copy this file to .env and replace AUTH_JWT_SECRET with a random secret (at least 32 characters).
# Note: scripts/Setup-Minio.ps1 automatically creates .env with a generated AUTH_JWT_SECRET if missing.

# --- Backend ---
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters-for-local-jwt
DEMO_ENABLED=true
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=music_player
POSTGRES_USER=music_app
POSTGRES_PASSWORD=music_local_dev_only
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432

# --- MinIO (ports and region; root credentials live in storage/.env, reader credentials in storage/backend.env) ---
MINIO_REGION=us-east-1
MINIO_BUCKET=music-demo
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
